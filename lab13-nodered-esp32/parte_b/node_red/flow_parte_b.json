    {
        "id": "b_evento_esp",
        "type": "function",
        "z": "flow_lab13b",
        "name": "Evento del ESP32",
        "func": "// Eventos que publica el ESP32 en el topic de auditoría\nconst e = String(msg.payload).slice(0, 120);\nconst nivel = e.startsWith('COMANDO_RECHAZADO') || e.startsWith('SENSOR_ERROR') ? 'alerta' : 'info';\nreturn { payload: { nivel, origen: 'esp32', evento: e.split(':')[0], detalle: e } };",
