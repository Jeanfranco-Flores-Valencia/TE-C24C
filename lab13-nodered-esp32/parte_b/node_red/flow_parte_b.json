    {
        "id": "b_acumular",
        "type": "function",
        "z": "flow_lab13b",
        "name": "Registrar auditoría",
        "func": "// Lista de los últimos 30 eventos + contadores para el dashboard\nconst e = msg.payload;\ne.hora = new Date().toLocaleTimeString('es-PE', { hour12: false });\nconst lista = flow.get('eventos') || [];\nlista.unshift({ hora: e.hora, nivel: e.nivel, origen: e.origen, evento: e.evento, detalle: e.detalle || '' });\nif (lista.length > 30) lista.length = 30;\nflow.set('eventos', lista);\nconst c = flow.get('contadores') || { aceptados: 0, rechazados: 0, alertas: 0 };\nif (e.evento === 'COMANDO_ACEPTADO') c.aceptados++;\nif (e.evento === 'COMANDO_RECHAZADO') c.rechazados++;\nif (e.nivel === 'alerta') c.alertas++;\nflow.set('contadores', c);\nreturn [{ payload: lista }, { payload: 'Comandos aceptados ' + c.aceptados + ' · rechazados ' + c.rechazados + ' · alertas ' + c.alertas }, { payload: e.evento + ' — ' + (e.detalle || '') }];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 260,
