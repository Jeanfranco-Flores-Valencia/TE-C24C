    {
        "id": "b_validar",
        "type": "function",
        "z": "flow_lab13b",
        "name": "Validar telemetría",
        "func": "// Valida la telemetría antes de mostrarla: tamaño, JSON, dispositivo, tipos,\n// rangos físicos, repetición (arranque + secuencia) y abuso de frecuencia.\nconst ID = 'floresvalencia';\nconst MAX_MSG = 6, VENTANA = 10000;     // el ESP32 publica 2 cada 10 s; margen para reconexiones\nconst ev = (nivel, evento, detalle) => node.send([null, { payload: { nivel, origen: 'node-red', evento, detalle } }]);\nconst rechazar = (evento, detalle, nivel = 'alerta') => { ev(nivel, evento, detalle); node.status({ fill: 'red', shape: 'ring', text: evento }); return null; };\n\nconst raw = typeof msg.payload === 'string' ? msg.payload : JSON.stringify(msg.payload);\n// Frecuencia: se cuenta todo lo que llega al topic\nconst t = (context.get('tiempos') || []).filter(x => Date.now() - x < VENTANA);\nt.push(Date.now()); context.set('tiempos', t);\nif (t.length > MAX_MSG) {\n  const avisos = context.get('avisosAbuso') || 0;\n  context.set('avisosAbuso', avisos + 1);\n  if (avisos % 5 === 0) ev('alerta', 'ABUSO_FRECUENCIA', t.length + ' mensajes en 10 s (máx. ' + MAX_MSG + '); se descartan');\n  node.status({ fill: 'red', shape: 'dot', text: 'ABUSO_FRECUENCIA' });\n  return null;\n}\ncontext.set('avisosAbuso', 0);\nif (raw.length > 512) return rechazar('TELEMETRIA_INVALIDA', 'mensaje de ' + raw.length + ' bytes');\nlet d; try { d = JSON.parse(raw); } catch (e) { return rechazar('TELEMETRIA_INVALIDA', 'no es JSON'); }\nif (!d || typeof d !== 'object' || Array.isArray(d)) return rechazar('TELEMETRIA_INVALIDA', 'no es un objeto');\nif (d.dispositivo !== ID) return rechazar('TELEMETRIA_INVALIDA', 'dispositivo desconocido: ' + String(d.dispositivo).slice(0, 20));\nif (typeof d.temperatura !== 'number' || typeof d.humedad !== 'number') return rechazar('TELEMETRIA_INVALIDA', 'temperatura/humedad no numéricas');\nif (d.temperatura < -40 || d.temperatura > 80) return rechazar('TELEMETRIA_ANOMALA', 'temperatura fuera de rango: ' + d.temperatura);\nif (d.humedad < 0 || d.humedad > 100) return rechazar('TELEMETRIA_ANOMALA', 'humedad fuera de rango: ' + d.humedad);\nif (!['ON', 'OFF'].includes(d.led)) return rechazar('TELEMETRIA_INVALIDA', 'estado de LED inválido');\nif (!Number.isInteger(d.secuencia) || d.secuencia < 1) return rechazar('TELEMETRIA_INVALIDA', 'secuencia inválida');\nif (typeof d.arranque !== 'string' || !/^[0-9a-f]{8}$/i.test(d.arranque)) return rechazar('TELEMETRIA_INVALIDA', 'arranque inválido');\n// Repetición: dentro del mismo arranque la secuencia debe crecer\nconst ult = context.get('ultima') || {};\nif (ult.arranque === d.arranque && d.secuencia <= ult.secuencia) return rechazar('TELEMETRIA_REPETIDA', 'secuencia ' + d.secuencia + ' <= ' + ult.secuencia);\nif (ult.arranque && ult.arranque !== d.arranque) ev('info', 'REINICIO_ESP32', 'arranque ' + ult.arranque + ' -> ' + d.arranque);\ncontext.set('ultima', { arranque: d.arranque, secuencia: d.secuencia });\nflow.set('ultimoMensaje', Date.now());\nflow.set('led', d.led);\nnode.status({ fill: 'green', shape: 'dot', text: 'OK sec ' + d.secuencia });\nreturn [{ payload: d }, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 100,
        "wires": [
            [
                "b_separar"
            ],
            [
                "b_acumular"
            ]
        ],
        "outputLabels": [
            "telemetría válida",
            "evento"
        ]
