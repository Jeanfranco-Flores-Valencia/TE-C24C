    {
        "id": "b_firmar",
        "type": "function",
        "z": "flow_lab13b",
        "name": "Firmar comando (HMAC)",
        "func": "// Firma el comando con HMAC-SHA256. La clave viene de la variable de entorno\n// LAB13_HMAC_KEY (no queda guardada en el flow). La secuencia es Date.now(),\n// que siempre crece aunque Node-RED se reinicie.\nconst ID = 'floresvalencia';\nconst clave = env.get('LAB13_HMAC_KEY');\nconst ev = (nivel, evento, detalle) => ({ payload: { nivel, origen: 'dashboard', evento, detalle } });\nif (!clave || clave.length < 16) {\n  node.status({ fill: 'red', shape: 'ring', text: 'falta LAB13_HMAC_KEY' });\n  return [null, ev('alerta', 'SIN_CLAVE', 'defina LAB13_HMAC_KEY antes de iniciar Node-RED')];\n}\nconst accion = msg.payload === 'ON' ? 'ON' : msg.payload === 'OFF' ? 'OFF' : null;\nif (!accion) return [null, ev('alerta', 'ACCION_INVALIDA', String(msg.payload))];\n// Límite de comandos desde el dashboard (máx. 10 por minuto)\nconst t = (context.get('tiempos') || []).filter(x => Date.now() - x < 60000);\nif (t.length >= 10) return [null, ev('alerta', 'ABUSO_COMANDOS', 'más de 10 comandos por minuto')];\nt.push(Date.now()); context.set('tiempos', t);\nlet secuencia = Date.now();\nconst previa = context.get('secuencia') || 0;\nif (secuencia <= previa) secuencia = previa + 1;\ncontext.set('secuencia', secuencia);\nconst firma = crypto.createHmac('sha256', clave).update(accion + '|' + secuencia + '|' + ID).digest('hex');\nconst cmd = { accion, secuencia, firma };\nflow.set('ultimoComando', JSON.stringify(cmd));   // para la prueba de repetición\nnode.status({ fill: 'green', shape: 'dot', text: accion + ' ' + secuencia });\nreturn [{ payload: JSON.stringify(cmd) }, ev('info', 'COMANDO_FIRMADO', accion + ' secuencia ' + secuencia)];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [
            {
                "var": "crypto",
                "module": "crypto"
            }
        ],
        "x": 380,
        "y": 520,
        "wires": [
            [
                "b_mqtt_comando"
