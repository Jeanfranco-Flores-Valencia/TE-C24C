        "name": "Convertir JSON",
        "property": "payload",
        "action": "obj",
        "pretty": false,
        "x": 340,
        "y": 100,
        "wires": [
            [
                "procesar_tele"
            ]
        ]
    },
    {
        "id": "procesar_tele",
        "type": "function",
        "z": "flow_lab13",
        "name": "Separar telemetría",
        "func": "const d=msg.payload;\nif(!d || typeof d.temperatura!=='number' || typeof d.humedad!=='number'){node.warn('Telemetría inválida');return null;}\nconst t={payload:d.temperatura,topic:'Temperatura'};\nconst h={payload:d.humedad,topic:'Humedad'};\nconst e={payload:`${d.dispositivo} | LED ${d.led} | Secuencia ${d.secuencia}`};\nreturn [t,h,e];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 100,
        "wires": [
            [
                "gauge_temp",
                "chart_ambiente"
            ],
            [
                "gauge_hum",
                "chart_ambiente"
            ],
            [
                "text_estado"
            ]
        ]
    },
