# ====== Copie este archivo a .env (NUNCA suba .env a Git) ======
# Genere valores aleatorios con:  npm run gen-secrets

PORT=3000

# Broker MQTT (Wokwi tiene salida a Internet por la red Wokwi-GUEST)
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_USER=
MQTT_PASS=
# Prefijo único para que nadie más publique en sus tópicos por casualidad
TOPIC_BASE=tecsup/lab14/CAMBIAME

# Dispositivos autorizados y su clave HMAC (>= 32 caracteres): id:clave,id2:clave2
# La misma clave va en firmware/include/secrets.h (DEVICE_HMAC_KEY)
DEVICE_KEYS=esp32-01:REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_64_HEX

# MongoDB Atlas (solo en el servidor; el ESP32 nunca la conoce). Vacío = memoria.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=esp32_iot

# Token para entrar al dashboard (>= 16 caracteres)
DASHBOARD_TOKEN=REEMPLAZAR

# ---- Parámetros de seguridad ----
REPLAY_WINDOW_S=30
RATE_MAX=12
RATE_WINDOW_S=10
BLOCK_S=60
BAD_SIG_MAX=5
CMD_MAX_PER_MIN=20
OFFLINE_S=20
TEMP_MIN=-40
TEMP_MAX=80
HUM_MIN=0
HUM_MAX=100
MAX_TEMP_JUMP=10
MAX_PAYLOAD=512
